# Copy to .env and adjust. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Every value here is read by platform/config, which validates all of them at startup and refuses
# to start if any is wrong (§46). There is no other place in the codebase that reads the
# environment.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

# development | production
APP_ENV=development

# ---------------------------------------------------------------------------
# Routing
# ---------------------------------------------------------------------------

# The single host Traefik routes. Path-based routing puts the app and the API on ONE origin:
#
#   ${PUBLIC_HOST}/         -> web
#   ${PUBLIC_HOST}/api/...  -> server
#   ${PUBLIC_HOST}/ws       -> server
#
# Same-origin is load-bearing, not cosmetic: it is what makes the session cookie work without a
# Domain attribute and removes CORS entirely. See ADR 0009.
#
# Development:  billiards.localhost        (*.localhost resolves to 127.0.0.1 on most systems)
# Production:   billiards-online.duckdns.org
PUBLIC_HOST=billiards.localhost

# Strict allowlist for CORS and, from Phase 5, the WebSocket upgrade Origin check.
# Matched by exact string equality — never a prefix or suffix test.
# Must include the scheme, and must be https when APP_ENV=production.
HTTP_ALLOWED_ORIGINS=http://billiards.localhost

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

HTTP_ADDR=:8080

# pprof and, from Phase 19, metrics. Must differ from HTTP_ADDR — the server refuses to start
# otherwise, because pprof exposes heap contents and goroutine stacks.
HTTP_INTERNAL_ADDR=0.0.0.0:6060

# Upper bound on graceful shutdown. Exceeding it drops in-flight requests, which beats a deploy
# that hangs forever.
HTTP_SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

POSTGRES_USER=billiards
# CHANGE THIS. A development-only default is still a default someone forgets to change.
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=billiards

# Host port for psql and integration tests. Bound to loopback by docker-compose.yml.
POSTGRES_PORT=5432

# Consumed by the server container, which reaches PostgreSQL over the compose network.
# Running the server outside Docker? Use localhost instead of postgres.
DATABASE_URL=postgres://billiards:change-me-in-your-local-env@postgres:5432/billiards?sslmode=disable

DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2

# Used by `make test-integration` from Phase 2 onward. A SEPARATE database: the test harness
# truncates and rolls back, and must never be pointed at a database with real data.
TEST_DATABASE_URL=postgres://billiards:change-me-in-your-local-env@localhost:5432/billiards_test?sslmode=disable

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# json | text   (text is easier to read locally; json is what you want in production)
LOG_FORMAT=json
